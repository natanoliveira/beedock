# Conexão da aplicação: host com -pooler, papel beedock_app (sujeito a RLS)
DATABASE_URL=
# Conexão direta (sem -pooler), papel dono das tabelas: migrations, seed e scripts
DIRECT_URL=
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública da aplicação (http://localhost:3004 em desenvolvimento)
AUTH_URL=
# Chave HMAC da cadeia de auditoria (fica só na aplicação, nunca no banco). Gere com: openssl rand -base64 32
AUDIT_HMAC_KEY=
# Token do Vercel Blob (Storage > Blob no painel da Vercel). Opcional: sem ele o upload de logo fica indisponível
BLOB_READ_WRITE_TOKEN=
# Cadastro público desligado (futuro SaaS)
ENABLE_SIGNUP=false
# Opcional: banco de teste para os testes de isolamento (papel beedock_app / papel dono)
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# MASTER inicial criado pelo pnpm db:seed (as três juntas ou nenhuma; senha 10+ caracteres)
SEED_MASTER_NAME=
SEED_MASTER_EMAIL=
SEED_MASTER_PASSWORD=
